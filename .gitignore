.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Local Swift/Xcode build products and per-user IDE state.
.build/
DerivedData/
*.xcresult
*.xcarchive
**/xcuserdata/
*.xcuserstate

# Local configuration and secrets. A documented example may be committed.
.env
.env.*
!.env.example

# Personal source media and generated analysis stay local.
input_media/*
!input_media/.gitkeep
output/

# Downloaded model weights are cached locally.
models/**/*.task
models/**/*.tflite
models/**/*.onnx
models/**/*.pt
models/**/*.pth
models/**/*.ckpt
models/**/*.safetensors
